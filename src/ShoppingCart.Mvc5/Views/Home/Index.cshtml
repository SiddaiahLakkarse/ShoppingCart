@model IEnumerable<ShoppingCart.Mvc5.Models.ProductModel>
@{ Layout = null; }
<!doctype html><html><head><title>Shopping Cart</title><link rel="stylesheet" href="/Content/site.css" /></head><body><h1>Shopping Cart</h1><p><a href="/Home/Login">Login</a> | <a href="/Home/Orders">Orders</a></p><div class="products">@foreach (var product in Model) { <article><h2>@product.Name</h2><p>@product.Description</p><strong>@product.Price.ToString("C")</strong><small> Stock: @product.Stock</small>@using (Html.BeginForm("AddToCart", "Home", FormMethod.Post)) { @Html.Hidden("ProductId", product.Id)<input name="Quantity" type="number" value="1" min="1" max="@product.Stock" /><button type="submit">Add to cart</button>}</article> }</div>@using (Html.BeginForm("Checkout", "Home", FormMethod.Post)) { <button type="submit">Checkout</button> }</body></html>
